//// JSON parsing and encoding for Donna.
////
//// Backed by the yyjson C library for fast, correct parsing.
////
//// ```donna
//// import json
////
//// let result = json.parse("{\"name\": \"Donna\", \"version\": 1}")
//// case result:
//// json.Err(_) -> "parse error"
//// json.Ok(value) ->
//// case json.get(value, "name"):
//// json.Err(_) -> ""
//// json.Ok(name) -> json.unwrap_string(json.as_string(name))
//// ```

import donna/float
import donna/list
import donna/string

/// A JSON value.
///
/// ```donna
/// import json
///
/// pub fn make_object() -> json.Json:
///   json.Object([#("ok", json.Bool(True)), #("count", json.Int(3))])
/// ```
pub type Json:
  Null
  Bool(Bool)
  Int(Int)
  Float(Float)
  Str(String)
  Array(List(Json))
  Object(List(#(String, Json)))

/// Result of a parse or lookup operation.
///
/// ```donna
/// import json
///
/// pub fn is_ok() -> Bool:
///   json.parse("{}") |> json.is_ok
/// ```
pub type Parsed(a):
  Ok(a)
  Err(String)

/// A handle to a C-backed yyjson document.
///
/// Use `open` to create a document and `close` when you are finished with it.
/// Querying a document is faster than materializing the whole JSON tree with
/// `parse`.
///
/// ```donna
/// import json
///
/// pub fn read_name(src: String) -> String:
///   case json.open(src):
///     json.Err(_) -> ""
///     json.Ok(doc) ->
///       let name = json.unwrap_string(json.query_string(doc, "user.name"))
///       let _ = json.close(doc)
///       name
/// ```
pub type Doc:
  Doc(Int)

@external("c", "donna_json_parse")
fn donna_json_parse(input: String) -> String

@external("c", "donna_json_is_valid")
fn donna_json_is_valid(input: String) -> Int

@external("c", "donna_json_doc_open")
fn donna_json_doc_open(input: String) -> Int

@external("c", "donna_json_doc_close")
fn donna_json_doc_close(handle: Int) -> Int

@external("c", "donna_json_doc_query")
fn donna_json_doc_query(handle: Int, path: String) -> String

@external("c", "donna_json_float_to_string")
fn donna_json_float_to_string(value: Json) -> String

/// Parse a JSON string into a `Json` value.
///
/// ```donna
/// import json
///
/// pub fn example() -> json.Parsed(json.Json):
///   json.parse("[1, 2, 3]")
/// ```
pub fn parse(input: String) -> Parsed(Json):
  let wire = donna_json_parse(input)
  let #(result, _) = parse_wire(wire, 0, string.length(wire))
  result

/// Return True when a string contains valid JSON.
///
/// This uses yyjson directly and does not allocate a Donna `Json` tree, so it
/// is the fastest way to check whether input is JSON.
///
/// ```donna
/// import json
///
/// pub fn example() -> Bool:
///   json.is_valid("{\"ok\": true}")
/// ```
pub fn is_valid(input: String) -> Bool:
  donna_json_is_valid(input) == 1

/// Open a JSON document as a C-backed handle.
///
/// The returned document must be closed with `json.close`.
///
/// ```donna
/// import json
///
/// pub fn example(src: String) -> json.Parsed(json.Doc):
///   json.open(src)
/// ```
pub fn open(input: String) -> Parsed(Doc):
  let handle = donna_json_doc_open(input)
  case handle == 0:
    True -> Err("invalid JSON")
    False -> Ok(Doc(handle))

/// Close a C-backed JSON document.
///
/// ```donna
/// import json
///
/// pub fn example(doc: json.Doc) -> Nil:
///   json.close(doc)
/// ```
pub fn close(doc: Doc) -> Nil:
  let _ = case doc:
    Doc(handle) -> donna_json_doc_close(handle)
  Nil

/// Query a value from a C-backed document by path.
///
/// Paths are dot-separated. Object keys use their name and array indexes use
/// numeric segments, for example `user.name` or `items.0.title`.
///
/// ```donna
/// import json
///
/// pub fn first_item(doc: json.Doc) -> json.Parsed(json.Json):
///   json.query(doc, "items.0")
/// ```
pub fn query(doc: Doc, path: String) -> Parsed(Json):
  let wire = case doc:
    Doc(handle) -> donna_json_doc_query(handle, path)
  let #(result, _) = parse_wire(wire, 0, string.length(wire))
  result

/// Query a string value from a C-backed document.
///
/// ```donna
/// import json
///
/// pub fn read(doc: json.Doc) -> json.Parsed(String):
///   json.query_string(doc, "name")
/// ```
pub fn query_string(doc: Doc, path: String) -> Parsed(String):
  case query(doc, path):
    Err(e) -> Err(e)
    Ok(value) -> as_string(value)

/// Query an integer value from a C-backed document.
///
/// ```donna
/// import json
///
/// pub fn read(doc: json.Doc) -> json.Parsed(Int):
///   json.query_int(doc, "version")
/// ```
pub fn query_int(doc: Doc, path: String) -> Parsed(Int):
  case query(doc, path):
    Err(e) -> Err(e)
    Ok(value) -> as_int(value)

/// Query a float value from a C-backed document.
///
/// ```donna
/// import json
///
/// pub fn read(doc: json.Doc) -> json.Parsed(Float):
///   json.query_float(doc, "ratio")
/// ```
pub fn query_float(doc: Doc, path: String) -> Parsed(Float):
  case query(doc, path):
    Err(e) -> Err(e)
    Ok(value) -> as_float(value)

/// Query a boolean value from a C-backed document.
///
/// ```donna
/// import json
///
/// pub fn read(doc: json.Doc) -> json.Parsed(Bool):
///   json.query_bool(doc, "ok")
/// ```
pub fn query_bool(doc: Doc, path: String) -> Parsed(Bool):
  case query(doc, path):
    Err(e) -> Err(e)
    Ok(value) -> as_bool(value)

/// Get a value from a JSON object by key.
///
/// ```donna
/// import json
///
/// pub fn read_name(obj: json.Json) -> String:
///   case json.get(obj, "name"):
///     json.Err(_) -> ""
///     json.Ok(v) -> json.unwrap_string(json.as_string(v))
/// ```
pub fn get(obj: Json, key: String) -> Parsed(Json):
  case obj:
    Object(pairs) -> lookup_key(pairs, key)
    _ -> Err("not an object")

/// Get an element from a JSON array by index (zero-based).
///
/// ```donna
/// import json
///
/// pub fn first(arr: json.Json) -> json.Parsed(json.Json):
///   json.at(arr, 0)
/// ```
pub fn at(arr: Json, index: Int) -> Parsed(Json):
  case arr:
    Array(items) ->
      case index < 0:
        True -> Err("index out of bounds")
        False -> list_at(items, index)
    _ -> Err("not an array")

/// Extract a string from a Json value.
///
/// ```donna
/// import json
///
/// pub fn read(v: json.Json) -> json.Parsed(String):
///   json.as_string(v)
/// ```
pub fn as_string(j: Json) -> Parsed(String):
  case j:
    Str(s) -> Ok(s)
    _ -> Err("not a string")

/// Extract an integer from a Json value.
///
/// ```donna
/// import json
///
/// pub fn read(v: json.Json) -> json.Parsed(Int):
///   json.as_int(v)
/// ```
pub fn as_int(j: Json) -> Parsed(Int):
  case j:
    Int(n) -> Ok(n)
    _ -> Err("not an integer")

/// Extract a float from a Json value.
///
/// ```donna
/// import json
///
/// pub fn read(v: json.Json) -> json.Parsed(Float):
///   json.as_float(v)
/// ```
pub fn as_float(j: Json) -> Parsed(Float):
  case j:
    Float(f) -> Ok(f)
    _ -> Err("not a float")

/// Extract a boolean from a Json value.
///
/// ```donna
/// import json
///
/// pub fn read(v: json.Json) -> json.Parsed(Bool):
///   json.as_bool(v)
/// ```
pub fn as_bool(j: Json) -> Parsed(Bool):
  case j:
    Bool(b) -> Ok(b)
    _ -> Err("not a boolean")

/// Extract the list of elements from a Json array.
///
/// ```donna
/// import json
///
/// pub fn read(v: json.Json) -> json.Parsed(List(json.Json)):
///   json.as_array(v)
/// ```
pub fn as_array(j: Json) -> Parsed(List(Json)):
  case j:
    Array(items) -> Ok(items)
    _ -> Err("not an array")

/// Extract the list of key-value pairs from a Json object.
///
/// ```donna
/// import json
///
/// pub fn read(v: json.Json) -> json.Parsed(List(#(String, json.Json))):
///   json.as_object(v)
/// ```
pub fn as_object(j: Json) -> Parsed(List(#(String, Json))):
  case j:
    Object(pairs) -> Ok(pairs)
    _ -> Err("not an object")

/// Return True when a Json value is Null.
///
/// ```donna
/// import json
///
/// pub fn example() -> Bool:
///   json.is_null(json.Null)
/// ```
pub fn is_null(j: Json) -> Bool:
  case j:
    Null -> True
    _ -> False

/// Return True when a Parsed result is Ok.
///
/// ```donna
/// import json
///
/// pub fn example() -> Bool:
///   json.is_ok(json.Ok(json.Null))
/// ```
pub fn is_ok(r: Parsed(a)) -> Bool:
  case r:
    Ok(_) -> True
    Err(_) -> False

/// Return True when a Parsed result is Err.
///
/// ```donna
/// import json
///
/// pub fn example() -> Bool:
///   json.is_err(json.Err("nope"))
/// ```
pub fn is_err(r: Parsed(a)) -> Bool:
  case r:
    Ok(_) -> False
    Err(_) -> True

/// Extract a string from a Parsed(String), returning a fallback on error.
///
/// ```donna
/// import json
///
/// pub fn example() -> String:
///   json.unwrap_string(json.Ok("Donna"))
/// ```
pub fn unwrap_string(r: Parsed(String)) -> String:
  case r:
    Ok(s) -> s
    Err(e) -> "__err:" <> e

/// Extract an integer from a Parsed(Int), returning 0 on error.
///
/// ```donna
/// import json
///
/// pub fn example() -> Int:
///   json.unwrap_int(json.Ok(42))
/// ```
pub fn unwrap_int(r: Parsed(Int)) -> Int:
  case r:
    Ok(n) -> n
    Err(_) -> 0

/// Extract a boolean from a Parsed(Bool), returning False on error.
///
/// ```donna
/// import json
///
/// pub fn example() -> Bool:
///   json.unwrap_bool(json.Ok(True))
/// ```
pub fn unwrap_bool(r: Parsed(Bool)) -> Bool:
  case r:
    Ok(b) -> b
    Err(_) -> False

/// Encode a Json value to a JSON string.
///
/// ```donna
/// import json
///
/// pub fn round_trip(j: json.Json) -> String:
///   json.encode(j)
/// ```
pub fn encode(j: Json) -> String:
  case j:
    Null -> "null"
    Bool(True) -> "true"
    Bool(False) -> "false"
    Int(n) -> int_to_string(n)
    Float(_) -> donna_json_float_to_string(j)
    Str(s) -> "\"" <> escape_str(s) <> "\""
    Array(items) -> "[" <> encode_array(items, True, "") <> "]"
    Object(pairs) -> "{" <> encode_object(pairs, True, "") <> "}"

fn encode_array(items: List(Json), first: Bool, acc: String) -> String:
  case items:
    [] -> acc
    [item, ..rest] ->
      let sep = case first:
        True -> ""
        False -> ","
      encode_array(rest, False, acc <> sep <> encode(item))

fn encode_object(
  pairs: List(#(String, Json)),
  first: Bool,
  acc: String
) -> String:
  case pairs:
    [] -> acc
    [#(k, v), ..rest] ->
      let sep = case first:
        True -> ""
        False -> ","
      encode_object(
        rest,
        False,
        acc <> sep <> "\"" <> escape_str(k) <> "\":" <> encode(v)
      )

fn escape_str(s: String) -> String:
  escape_chars(s, 0, string.length(s), "")

fn escape_chars(s: String, i: Int, len: Int, acc: String) -> String:
  case i >= len:
    True -> acc
    False ->
      let c = string.char_at(s, i)
      let out = case c:
        34 -> "\\\""
        92 -> "\\\\"
        10 -> "\\n"
        13 -> "\\r"
        9 -> "\\t"
        _ -> string.char_str(s, i)
      escape_chars(s, i + 1, len, acc <> out)

fn parse_wire(s: String, pos: Int, len: Int) -> #(Parsed(Json), Int):
  case pos >= len:
    True -> #(Err("unexpected end of input"), pos)
    False ->
      let sep = find_sep(s, len, pos)
      case sep < 0:
        True -> #(Err("unterminated token"), len)
        False ->
          let tag = string.char_at(s, pos)
          let payload_start = pos + 1
          let payload_len = sep - payload_start
          let payload = string.slice(s, payload_start, payload_len)
          let next_pos = sep + 1
          case tag:
            78 -> #(Ok(Null), next_pos)
            66 ->
              case string.equal(payload, "1"):
                True -> #(Ok(Bool(True)), next_pos)
                False -> #(Ok(Bool(False)), next_pos)
            73 -> #(Ok(Int(string.to_int(payload))), next_pos)
            70 -> #(Ok(Float(float.parse(payload))), next_pos)
            83 -> #(Ok(Str(unescape_payload(payload))), next_pos)
            65 ->
              let count = string.to_int(payload)
              let #(items, after_items) = parse_n_wire(s, len, next_pos, count, [])
              #(Ok(Array(items)), after_items)
            79 ->
              let count = string.to_int(payload)
              let #(pairs, after_pairs) = parse_pairs_wire(s, len, next_pos, count, [])
              #(Ok(Object(pairs)), after_pairs)
            69 -> #(Err(payload), next_pos)
            _ -> #(Err("unknown token"), next_pos)

fn find_sep(s: String, len: Int, i: Int) -> Int:
  case i >= len:
    True -> -1
    False ->
      case string.char_at(s, i) == 1:
        True -> i
        False -> find_sep(s, len, i + 1)

fn parse_n_wire(
  s: String,
  len: Int,
  pos: Int,
  count: Int,
  acc: List(Json)
) -> #(List(Json), Int):
  case count <= 0:
    True -> #(list.reverse(acc), pos)
    False ->
      let #(result, next) = parse_wire(s, pos, len)
      case result:
        Err(_) -> #(list.reverse(acc), next)
        Ok(value) -> parse_n_wire(s, len, next, count - 1, [value, ..acc])

fn parse_pairs_wire(
  s: String,
  len: Int,
  pos: Int,
  count: Int,
  acc: List(#(String, Json))
) -> #(List(#(String, Json)), Int):
  case count <= 0:
    True -> #(list.reverse(acc), pos)
    False ->
      let #(key_result, after_key) = parse_wire(s, pos, len)
      case key_result:
        Err(_) -> #(list.reverse(acc), after_key)
        Ok(key_val) ->
          let key = case key_val:
            Str(k) -> k
            _ -> ""
          let #(val_result, after_val) = parse_wire(s, after_key, len)
          case val_result:
            Err(_) -> #(list.reverse(acc), after_val)
            Ok(value) ->
              parse_pairs_wire(
                s,
                len,
                after_val,
                count - 1,
                [#(key, value), ..acc]
              )

fn unescape_payload(s: String) -> String:
  unescape_chars(s, 0, string.length(s), "")

fn unescape_chars(s: String, i: Int, len: Int, acc: String) -> String:
  case i >= len:
    True -> acc
    False ->
      let c = string.char_at(s, i)
      case c == 2 && i + 1 < len:
        True ->
          case string.char_at(s, i + 1):
            49 -> unescape_chars(s, i + 2, len, acc <> "")
            50 -> unescape_chars(s, i + 2, len, acc <> "")
            _ -> unescape_chars(s, i + 1, len, acc <> string.char_str(s, i))
        False -> unescape_chars(s, i + 1, len, acc <> string.char_str(s, i))

fn lookup_key(pairs: List(#(String, Json)), key: String) -> Parsed(Json):
  case pairs:
    [] -> Err("key '" <> key <> "' not found")
    [#(k, v), ..rest] ->
      case string.equal(k, key):
        True -> Ok(v)
        False -> lookup_key(rest, key)

fn list_at(items: List(Json), index: Int) -> Parsed(Json):
  case items:
    [] -> Err("index out of bounds")
    [item, ..rest] ->
      case index:
        0 -> Ok(item)
        _ -> list_at(rest, index - 1)
